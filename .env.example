# Set PORT to the port supplied by your hosting provider (optional).
# The server defaults to port 3000 when PORT is not set.
PORT=3000

# Firebase Admin credentials for local Express API use. Keep the key outside Git.
FIREBASE_PROJECT_ID=kieltech
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
AUTH_CONTINUE_URL=https://kieltech-academy.web.app

# Gmail / Google Workspace SMTP. Use an app password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-verified-sender@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-verified-sender@gmail.com
SMTP_FROM_NAME=KielTech Academy
