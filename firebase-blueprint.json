{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated student or faculty user profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID matching auth.uid" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "displayName": { "type": "string", "description": "Full student name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "role": { "type": "string", "enum": ["student", "faculty", "admin"], "description": "User academic role" },
        "studentId": { "type": "string", "description": "Institutional Student ID (e.g. KT-XXXX)" },
        "currentCourseId": { "type": "string", "description": "Active course ID" },
        "matriculationDate": { "type": "string", "description": "Enrollment timestamp" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last activity timestamp" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "description": "Student progress, assessment scores, and defense status for a specific curriculum.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID matching auth.uid" },
        "courseId": { "type": "string", "description": "Course identifier (e.g. python, rust, etc.)" },
        "currentStageId": { "type": "number", "description": "Active module index" },
        "defensePassed": { "type": "boolean", "description": "Whether the comprehensive defense was cleared" },
        "defenseScore": { "type": "number", "description": "Final defense exam percentage score" },
        "conferredDiplomaDate": { "type": "string", "description": "Timestamp when diploma was awarded" },
        "updatedAt": { "type": "string", "description": "Last progress update timestamp" }
      },
      "required": ["userId", "courseId", "currentStageId"]
    },
    "LessonBookmark": {
      "title": "LessonBookmark",
      "description": "Bookmarked curriculum topic or lesson note.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Bookmark ID" },
        "userId": { "type": "string", "description": "User ID matching auth.uid" },
        "lessonId": { "type": "string", "description": "Curriculum lesson key" },
        "lessonTitle": { "type": "string", "description": "Lesson topic title" },
        "stageId": { "type": "number", "description": "Stage number" },
        "stageTitle": { "type": "string", "description": "Stage module title" },
        "courseId": { "type": "string", "description": "Course identifier" },
        "createdAt": { "type": "string", "description": "Created timestamp" }
      },
      "required": ["id", "userId", "lessonId", "stageId", "courseId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Student profile documents. Only the authenticated student can read and write their own profile."
    },
    "/users/{userId}/progress/{courseId}": {
      "schema": "CourseProgress",
      "description": "Course learning progress, module unlocks, and test records."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "LessonBookmark",
      "description": "Saved bookmarks and notes for quick reference."
    }
  }
}
